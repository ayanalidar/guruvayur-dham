// Guruvayur Dham — Prisma schema
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ============ ROOMS ============ */
model Room {
  id            String       @id @default(cuid())
  slug          String       @unique
  name          String
  type          String       // AC | Non-AC | Family | Deluxe
  price         Int
  originalPrice Int?
  rating        Float        @default(4.7)
  reviews       Int          @default(0)
  capacity      Int
  size          String
  bedType       String
  image         String
  gallery       String       // JSON array of URLs
  badge         String?
  description   String
  shortDesc     String
  amenities     String       // JSON array of strings
  totalUnits    Int          @default(1) // how many physical rooms of this type
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  bookings      Booking[]
  rates         RatePlan[]
  availability  Availability[]
}

/* ============ BOOKINGS ============ */
model Booking {
  id              String          @id @default(cuid())
  reference       String          @unique // GD-XXXXXX
  roomId          String
  room            Room            @relation(fields: [roomId], references: [id])
  guestName       String
  guestPhone      String
  guestEmail      String?
  checkIn         DateTime
  checkOut        DateTime
  nights          Int
  guests          Int             @default(2)
  amount          Int             // total in INR
  status          String          @default("CONFIRMED") // CONFIRMED | CHECKED_IN | CHECKED_OUT | CANCELLED
  source          String          @default("DIRECT") // DIRECT | WALKIN | BOOKING_COM | MAKEMYTRIP | GOIBIBO | AGODA
  channelBookingId String?        // booking id from channel partner
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  syncLogs        SyncLog[]
}

/* ============ RATE PLANS (per room, per channel) ============ */
model RatePlan {
  id              String         @id @default(cuid())
  roomId          String
  room            Room           @relation(fields: [roomId], references: [id])
  channelPartner  String         // DIRECT | BOOKING_COM | MAKEMYTRIP | GOIBIBO | AGODA
  priceModifier   Float          @default(1.0) // multiplier on room.price
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([roomId, channelPartner])
}

/* ============ CHANNEL PARTNERS ============ */
model ChannelPartner {
  id              String         @id @default(cuid())
  code            String         @unique // BOOKING_COM | MAKEMYTRIP | GOIBIBO | AGODA
  name            String
  logo            String
  webhookUrl      String         // where we POST block/unblock events
  apiEndpoint     String         // where we receive their bookings
  connected       Boolean        @default(true)
  lastSyncAt      DateTime?
  totalBookings   Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

/* ============ SYNC LOG (audit trail of all channel syncs) ============ */
model SyncLog {
  id              String         @id @default(cuid())
  bookingId       String?
  booking         Booking?       @relation(fields: [bookingId], references: [id])
  channel         String         // BOOKING_COM | MAKEMYTRIP | GOIBIBO | AGODA | DIRECT
  action          String         // BLOCK | UNBLOCK | BOOKING_RECEIVED | SYNC_ERROR
  status          String         // SUCCESS | FAILED | PENDING
  message         String
  payload         String?        // JSON
  createdAt       DateTime       @default(now())
}

/* ============ CONTENT BLOCKS (CMS) ============ */
// Every editable piece of text on the site has a unique key.
// Admin edits the value; frontend reads from here.
model ContentBlock {
  id              String         @id @default(cuid())
  key             String         @unique // e.g. "hero.headline", "about.story"
  value           String         // text content (can be multi-line / JSON)
  category        String         @default("general") // hero | about | rooms | pooja | contact | nav | footer
  label           String?        // human-readable label for admin UI
  updatedAt       DateTime       @updatedAt
}

/* ============ AVAILABILITY CACHE (per room per day) ============ */
model Availability {
  id              String         @id @default(cuid())
  roomId          String
  room            Room           @relation(fields: [roomId], references: [id])
  date            DateTime       // the specific night
  available       Int            // units still bookable
  lockedBy        String?        // comma-separated booking refs that hold this date
  priceOverride   Int?           // dynamic price for this date (null = use room.price)
  maintenanceNote String?        // if set, room is under maintenance
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([roomId, date])
}

/* ============ DYNAMIC PRICING RULES ============ */
model DynamicPricingRule {
  id              String   @id @default(cuid())
  name            String   // e.g. "Weekend Surge", "Ekadasi Festival"
  type            String   // WEEKEND | FESTIVAL | LAST_MINUTE | EARLY_BIRD | SEASONAL
  multiplier      Float    // 1.3 = 30% surge, 0.8 = 20% off
  startDate       DateTime?
  endDate         DateTime?
  dayOfWeek       String?  // comma-separated: "5,6" for Fri,Sat (null = all days)
  roomType        String?  // null = all rooms, else filter by type
  active          Boolean  @default(true)
  priority        Int      @default(0) // higher = applied first
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/* ============ COUPONS & PROMO CODES ============ */
model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique // EARLYBIRD10, EKADASI2026
  description     String
  type            String   // PERCENTAGE | FLAT
  value           Float    // 10 = 10% off, or 200 = ₹200 off
  maxDiscount     Int?     // cap for percentage coupons
  minBooking      Int      // minimum booking amount
  usageLimit      Int      // total times usable (0 = unlimited)
  usedCount       Int      @default(0)
  validFrom       DateTime
  validTo         DateTime
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/* ============ WAITING LIST ============ */
model WaitingList {
  id              String   @id @default(cuid())
  roomSlug        String
  checkIn         DateTime
  checkOut        DateTime
  guestName       String
  guestPhone      String
  guestEmail      String?
  guests          Int      @default(2)
  status          String   @default("WAITING") // WAITING | NOTIFIED | BOOKED | EXPIRED
  notifiedAt      DateTime?
  bookingRef      String?  // if converted to booking
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/* ============ POOJA BOOKINGS ============ */
model PoojaBooking {
  id              String   @id @default(cuid())
  reference       String   @unique // PB-XXXXXX
  poojaId         String   // matches pooja.id in site-data
  poojaName       String
  guestName       String
  guestPhone      String
  guestEmail      String?
  preferredDate   DateTime
  amount          Int
  status          String   @default("SCHEDULED") // SCHEDULED | AT_TEMPLE | COMPLETED | PRASADAM_READY | PICKED_UP | CANCELLED
  prasadamNote    String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/* ============ REMINDERS (Darshan slots, check-in, etc.) ============ */
model Reminder {
  id              String   @id @default(cuid())
  type            String   // DARSHAN | CHECK_IN | CHECK_OUT | POOJA | FESTIVAL
  bookingRef      String?
  guestName       String
  guestPhone      String
  message         String
  scheduledFor    DateTime
  sent            Boolean  @default(false)
  sentAt          DateTime?
  channel         String   @default("WHATSAPP") // WHATSAPP | SMS | EMAIL
  createdAt       DateTime @default(now())
}

/* ============ FESTIVAL ALERTS OPT-IN ============ */
model FestivalAlert {
  id              String   @id @default(cuid())
  guestName       String
  guestPhone      String
  guestEmail      String?
  festivals       String   // JSON array of festival names
  notifyDays      String   @default("30,7,1") // days before
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
}

/* ============ ITINERARIES ============ */
model Itinerary {
  id              String   @id @default(cuid())
  reference       String   @unique // IT-XXXXXX
  guestName       String
  guestPhone      String
  days            Int
  startDate       DateTime
  items           String   // JSON array of {day, time, title, description, type}
  totalEstimate   Int
  status          String   @default("DRAFT") // DRAFT | CONFIRMED | COMPLETED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/* ============ CRM: CUSTOMERS ============ */
model Customer {
  id              String   @id @default(cuid())
  name            String
  phone           String   @unique
  email           String?
  city            String?
  totalBookings   Int      @default(0)
  totalRevenue    Int      @default(0)
  loyaltyPoints   Int      @default(0)
  preferences     String?  // JSON: preferred room type, dietary, etc.
  notes           String?
  tags            String?  // comma-separated: VIP, REPEAT, FESTIVAL_GOER
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/* ============ HOUSEKEEPING STATUS ============ */
model HousekeepingStatus {
  id              String   @id @default(cuid())
  roomNumber      String   @unique // physical room number, e.g. "101", "102A"
  roomSlug        String   // links to Room type
  status          String   @default("READY") // READY | OCCUPIED | DIRTY | CLEANING | INSPECT | MAINTENANCE
  assignedTo      String?  // housekeeping staff name
  lastCleanedAt   DateTime?
  notes           String?
  updatedAt       DateTime @updatedAt
}

/* ============ STAFF USERS ============ */
model StaffUser {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  phone           String?
  role            String   @default("RECEPTIONIST") // MANAGER | RECEPTIONIST | HOUSEKEEPING | ACCOUNTANT
  pin             String   // 4-digit PIN for quick login
  active          Boolean  @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/* ============ MAINTENANCE BLOCKS ============ */
model MaintenanceBlock {
  id              String   @id @default(cuid())
  roomSlug        String
  roomNumber      String?
  startDate       DateTime
  endDate         DateTime
  reason          String   // e.g. "AC repair", "Painting"
  status          String   @default("SCHEDULED") // SCHEDULED | IN_PROGRESS | COMPLETED
  cost            Int?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/* ============ KITCHEN ORDERS ============ */
model KitchenOrder {
  id              String   @id @default(cuid())
  reference       String   @unique // KO-XXXXXX
  roomNumber      String
  guestName       String
  guestPhone      String?
  items           String   // JSON array of {itemId, name, qty, price}
  total           Int
  status          String   @default("NEW") // NEW | PREPARING | READY | DELIVERED | CANCELLED
  notes           String?
  printedAt       DateTime? // when sent to kitchen printer
  deliveredAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/* ============ MENU ITEMS ============ */
model MenuItem {
  id              String   @id @default(cuid())
  name            String
  description     String
  price           Int
  category        String   // BREAKFAST | LUNCH | DINNER | SNACKS | BEVERAGES
  veg             Boolean  @default(true)
  available       Boolean  @default(true)
  prepTime        Int      @default(15) // minutes
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/* ============ TRAVEL AGENTS (B2B) ============ */
model TravelAgent {
  id              String   @id @default(cuid())
  companyName     String
  contactName     String
  phone           String
  email           String?
  commissionRate  Float    @default(0.12) // 12% default
  creditLimit     Int      @default(50000) // deferred payment limit
  outstanding     Int      @default(0)
  totalBookings   Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/* ============ BLOG POSTS (CMS) ============ */
model BlogPost {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  excerpt         String
  category        String
  readTime        String
  date            String
  image           String
  content         String   // JSON array of paragraphs
  published       Boolean  @default(true)
  scheduledAt     DateTime? // if set, auto-publish at this time
  seoTitle        String?  // custom SEO title
  seoDescription  String?  // custom meta description
  seoKeywords     String?  // comma-separated keywords
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/* ============ GALLERY IMAGES (CMS) ============ */
model GalleryImage {
  id              String   @id @default(cuid())
  tab             String   // Rooms | Temple | Facilities | Surroundings
  src             String
  alt             String
  caption         String
  span            String?  // tall | wide | normal
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/* ============ REVIEW REQUESTS (Google Reviews automation) ============ */
model ReviewRequest {
  id              String   @id @default(cuid())
  bookingRef      String
  guestName       String
  guestPhone      String
  guestEmail      String?
  sentAt          DateTime?
  status          String   @default("PENDING") // PENDING | SENT | COMPLETED | SKIPPED
  reviewLink      String   @default("https://g.page/r/GURUVAYUR_DHAM/review")
  createdAt       DateTime @default(now())
}

/* ============ NOTIFICATIONS (broadcast log) ============ */
model Notification {
  id              String   @id @default(cuid())
  type            String   // SMS | EMAIL | WHATSAPP | TELEGRAM
  recipient       String
  subject         String?
  body            String
  status          String   @default("QUEUED") // QUEUED | SENT | FAILED
  sentAt          DateTime?
  relatedRef      String?  // booking or pooja reference
  createdAt       DateTime @default(now())
}

/* ============ EARLY-BIRD CAMPAIGNS ============ */
model EarlyBirdCampaign {
  id              String   @id @default(cuid())
  name            String   // "Ekadasi 2026 Early Bird"
  festivalName    String
  startDate       DateTime
  endDate         DateTime
  discountPercent Float    @default(15)
  bookingWindowStart DateTime
  bookingWindowEnd   DateTime
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/* ============ USER (Guest + Staff Auth) ============ */
model User {
  id              String   @id @default(cuid())
  name            String
  email           String?  @unique
  phone           String?  @unique
  passwordHash    String?  // null if OTP-only
  customerId      String?  // link to CRM Customer record
  role            String   @default("GUEST") // GUEST | STAFF
  staffId         String?  // if role=STAFF, link to StaffUser
  lastLoginAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  sessions        Session[]
  passwordResets  PasswordReset[]
  twoFactor       TwoFactorSecret?
}

/* ============ SESSION TOKENS ============ */
model Session {
  id              String   @id @default(cuid())
  token           String   @unique
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            String   // GUEST | MANAGER | RECEPTIONIST | HOUSEKEEPING | ACCOUNTANT
  expiresAt       DateTime
  createdAt       DateTime @default(now())
}

/* ============ REVIEWS (Google mirror + manual) ============ */
model Review {
  id              String   @id @default(cuid())
  authorName      String
  authorAvatar    String?
  rating          Int      // 1-5
  text            String
  reviewDate      DateTime
  source          String   @default("GOOGLE") // GOOGLE | MANUAL | GUEST_SUBMITTED | BOOKING_COM | MAKEMYTRIP
  googleReviewId  String?  @unique // for dedup when importing from Google
  googleProfileUrl String?
  language        String   @default("en")
  published       Boolean  @default(true)
  featured        Boolean  @default(false) // show on homepage
  // Guest submission fields
  guestEmail      String?
  guestPhone      String?
  roomSlug        String?  // which room they stayed in
  stayDate        DateTime? // when they stayed
  moderated       Boolean  @default(false) // has admin reviewed this submission
  moderatedBy     String?  // staff user ID who moderated
  moderatedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/* ============ AUDIT LOG ============ */
model AuditLog {
  id              String   @id @default(cuid())
  userId          String?  // staff user ID
  userName        String?
  action          String   // CREATE | UPDATE | DELETE | LOGIN | LOGOUT | EXPORT
  entity          String   // BOOKING | ROOM | CONTENT | REVIEW | COUPON | etc.
  entityId        String?
  details         String?  // JSON of changes
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime @default(now())
}

/* ============ PASSWORD RESET ============ */
model PasswordReset {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token           String   @unique
  expiresAt       DateTime
  used            Boolean  @default(false)
  createdAt       DateTime @default(now())
}

/* ============ 2FA (TOTP) ============ */
model TwoFactorSecret {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret          String   // TOTP secret (base32)
  enabled         Boolean  @default(false)
  backupCodes     String?  // JSON array of backup codes
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/* ============ PUSH NOTIFICATION SUBSCRIPTIONS ============ */
model PushSubscription {
  id              String   @id @default(cuid())
  userId          String?  // null for anonymous
  endpoint        String   @unique
  keys            String   // JSON: { p256dh, auth }
  userAgent       String?
  createdAt       DateTime @default(now())
}

/* ============ A/B TEST VARIANTS ============ */
model ABTest {
  id              String   @id @default(cuid())
  name            String   // "hero_headline_test"
  description     String?
  variants        String   // JSON: [{ key, label, weight }]
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/* ============ ANALYTICS EVENTS ============ */
model AnalyticsEvent {
  id              String   @id @default(cuid())
  eventType       String   // PAGE_VIEW | BOOKING_STARTED | BOOKING_COMPLETED | ROOM_VIEW | POOJA_VIEW | etc.
  page            String?  // current path
  userId          String?  // if logged in
  sessionId       String?  // browser session
  properties      String?  // JSON of additional data
  referrer        String?
  userAgent       String?
  ipAddress       String?
  createdAt       DateTime @default(now())
}

/* ============ INFLUENCER ============ */
model Influencer {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  phone           String?
  socialPlatform  String   // YOUTUBE | INSTAGRAM | TWITTER | BLOG | OTHER
  socialHandle    String
  followerCount   Int      @default(0)
  uniqueCode      String   @unique // e.g. INFLUENCER10
  commissionRate  Float    @default(0.10) // 10% default
  totalClicks     Int      @default(0)
  totalBookings   Int      @default(0)
  totalCommission Int      @default(0)
  status          String   @default("PENDING") // PENDING | APPROVED | REJECTED | SUSPENDED
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  clicks          InfluencerClick[]
}

/* ============ INFLUENCER CLICKS ============ */
model InfluencerClick {
  id              String   @id @default(cuid())
  influencerId    String
  influencer      Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  ipAddress       String?
  userAgent       String?
  referrer        String?
  convertedToBooking Boolean @default(false)
  bookingRef      String?
  createdAt       DateTime @default(now())
}

/* ============ PERFORMANCE METRICS ============ */
model PerformanceMetric {
  id              String   @id @default(cuid())
  page            String
  lcp             Float?   // Largest Contentful Paint (ms)
  fid             Float?   // First Input Delay (ms)
  cls             Float?   // Cumulative Layout Shift
  ttfb            Float?   // Time to First Byte (ms)
  fcp             Float?   // First Contentful Paint (ms)
  sessionId       String?
  userAgent       String?
  connection      String?  // 4g, 3g, wifi
  createdAt       DateTime @default(now())
}

/* ============ RATE LIMIT LOG ============ */
model RateLimitLog {
  id              String   @id @default(cuid())
  ipAddress       String
  endpoint        String
  method          String
  blocked         Boolean  @default(false)
  attempts        Int
  createdAt       DateTime @default(now())
}

/* ============ CHANNEL PARTNER CONFIG (dynamic, any OTA) ============ */
model ChannelConfig {
  id              String   @id @default(cuid())
  code            String   @unique // BOOKING_COM, MAKEMYTRIP, GOIBIBO, AGODA, EXPEDIA, MMT_LITE, ETC
  name            String
  logo            String?
  category        String   @default("OTA") // OTA | HOSTING | MESSAGING | PAYMENT | ANALYTICS
  apiEndpoint     String?  // their API URL for inventory push
  webhookUrl      String?  // their webhook URL that calls our /api/channel-inbox
  apiKey          String?  // encrypted in production
  apiSecret       String?
  hotelId         String?  // property ID on their platform
  connected       Boolean  @default(false)
  lastSyncAt      DateTime?
  lastSyncStatus  String?  // SUCCESS | FAILED | PENDING
  lastSyncMessage String?
  config          String?  // JSON: extra fields specific to this partner
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/* ============ SEO AUDIT LOG ============ */
model SeoAudit {
  id              String   @id @default(cuid())
  page            String
  titleLength     Int?
  descriptionLength Int?
  hasH1           Boolean  @default(false)
  hasSchema       Boolean  @default(false)
  hasCanonical    Boolean  @default(false)
  hasOgTags       Boolean  @default(false)
  imageCount      Int      @default(0)
  imagesWithoutAlt Int     @default(0)
  wordCount       Int      @default(0)
  score           Int      @default(0) // 0-100
  issues          String?  // JSON array of issues
  createdAt       DateTime @default(now())
}
