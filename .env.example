# ============================================================================
# Guruvayur Dham — Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values.
# For VPS deployment, see README-VPS.md.
# ============================================================================

# ----- DOMAIN (required for VPS / Caddy HTTPS) -----
# The domain name pointing to your VPS. Caddy will auto-obtain SSL certs.
DOMAIN=guruvayurdham.com

# ----- POSTGRES (used by docker-compose) -----
POSTGRES_USER=guruvayur
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=guruvayur_dham

# ----- DATABASE (required) -----
# On VPS with docker-compose, use the postgres service name as host:
DATABASE_URL=postgresql://guruvayur:change_me_to_a_strong_password@postgres:5432/guruvayur_dham?schema=public

# ----- AUTH -----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change_me_to_a_random_32_char_string

# ----- RAZORPAY (payments) -----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ----- GOOGLE OAUTH (optional — for guest/staff login) -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- FACEBOOK OAUTH (optional) -----
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ----- AI / CHATBOT (optional — falls back to z-ai if not set) -----
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ----- GOOGLE PLACES (optional — for Google Reviews widget) -----
GOOGLE_PLACES_API_KEY=

# ----- WHATSAPP BUSINESS API (optional — for WhatsApp chatbot + review funnel) -----
# If not set, the website chat widget still works (uses internal bot).
# To enable real WhatsApp, set up Meta WhatsApp Business API:
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ----- VAPID (push notifications — optional) -----
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ----- BLOB STORAGE (optional — for image uploads) -----
# If set, uses Vercel Blob (cloud). If not set, falls back to local /public/uploads/.
# On VPS, leave UNSET to use local filesystem (persistent volume).
BLOB_READ_WRITE_TOKEN=

# ----- CRON SECRET (optional — protects the review-funnel cron endpoint) -----
# Set this to a random string. The cron will need to send it as ?key= param.
CRON_SECRET=
